---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryPage from '../../components/pages/CategoryPage.astro';
import { categories, type CategorySlug } from '../../tools/registry';
import { categorySchemas } from '../../lib/schema';
import { t } from '../../i18n/utils';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category } }));
}

const lang = 'en';
const category = Astro.params.category as CategorySlug;
---

<BaseLayout
  lang={lang}
  title={t(lang, `categoryPages.${category}.title`)}
  description={t(lang, `categoryPages.${category}.description`)}
  schema={categorySchemas(lang, category)}
>
  <CategoryPage lang={lang} category={category} />
</BaseLayout>
