---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/ToolShell.astro';
import { getTool, tools } from '../../tools/registry';
import { t } from '../../i18n/utils';
import { toolSchemas } from '../../lib/schema';
import JsonFormatter from '../../components/tools/JsonFormatter.astro';
import Base64Converter from '../../components/tools/Base64Converter.astro';
import PasswordGenerator from '../../components/tools/PasswordGenerator.astro';
import UrlConverter from '../../components/tools/UrlConverter.astro';
import UuidGenerator from '../../components/tools/UuidGenerator.astro';
import TimestampConverter from '../../components/tools/TimestampConverter.astro';
import HtmlEntityConverter from '../../components/tools/HtmlEntityConverter.astro';
import ColorConverter from '../../components/tools/ColorConverter.astro';
import NumberBaseConverter from '../../components/tools/NumberBaseConverter.astro';
import WordCounter from '../../components/tools/WordCounter.astro';
import CaseConverter from '../../components/tools/CaseConverter.astro';
import TextReverser from '../../components/tools/TextReverser.astro';
import RemoveDuplicateLines from '../../components/tools/RemoveDuplicateLines.astro';
import PercentageCalculator from '../../components/tools/PercentageCalculator.astro';
import BmiCalculator from '../../components/tools/BmiCalculator.astro';
import DateDifference from '../../components/tools/DateDifference.astro';
import RandomNumberGenerator from '../../components/tools/RandomNumberGenerator.astro';
import QrCodeGenerator from '../../components/tools/QrCodeGenerator.astro';
import QrCodeScanner from '../../components/tools/QrCodeScanner.astro';
import RegexTester from '../../components/tools/RegexTester.astro';
import ImageCompressor from '../../components/tools/ImageCompressor.astro';
import ImageConverter from '../../components/tools/ImageConverter.astro';
import ImageToBase64 from '../../components/tools/ImageToBase64.astro';
import ImageResizer from '../../components/tools/ImageResizer.astro';
import ExifViewer from '../../components/tools/ExifViewer.astro';
import ImageWatermark from '../../components/tools/ImageWatermark.astro';
import ImageColorPicker from '../../components/tools/ImageColorPicker.astro';
import FaviconGenerator from '../../components/tools/FaviconGenerator.astro';
import ImageCropper from '../../components/tools/ImageCropper.astro';
import ImageFilters from '../../components/tools/ImageFilters.astro';
import ImageToAscii from '../../components/tools/ImageToAscii.astro';
import ImageRotator from '../../components/tools/ImageRotator.astro';
import MetadataRemover from '../../components/tools/MetadataRemover.astro';
import ColorExtractor from '../../components/tools/ColorExtractor.astro';
import UnitConverter from '../../components/tools/UnitConverter.astro';
import ScientificCalculator from '../../components/tools/ScientificCalculator.astro';
import HashGenerator from '../../components/tools/HashGenerator.astro';
import JwtDecoder from '../../components/tools/JwtDecoder.astro';
import TextDiff from '../../components/tools/TextDiff.astro';
import MortgageCalculator from '../../components/tools/MortgageCalculator.astro';
import AgeCalculator from '../../components/tools/AgeCalculator.astro';
import TipCalculator from '../../components/tools/TipCalculator.astro';
import CompoundInterestCalculator from '../../components/tools/CompoundInterestCalculator.astro';
import MarkdownEditor from '../../components/tools/MarkdownEditor.astro';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { category: tool.category, tool: tool.slug },
  }));
}

const lang = 'en';
const { tool: slug } = Astro.params;
const tool = getTool(slug)!;

const implementations = {
  'json-formatter': JsonFormatter,
  'base64-converter': Base64Converter,
  'password-generator': PasswordGenerator,
  'url-converter': UrlConverter,
  'uuid-generator': UuidGenerator,
  'timestamp-converter': TimestampConverter,
  'html-entity-converter': HtmlEntityConverter,
  'color-converter': ColorConverter,
  'number-base-converter': NumberBaseConverter,
  'word-counter': WordCounter,
  'case-converter': CaseConverter,
  'text-reverser': TextReverser,
  'remove-duplicate-lines': RemoveDuplicateLines,
  'percentage-calculator': PercentageCalculator,
  'bmi-calculator': BmiCalculator,
  'date-difference': DateDifference,
  'random-number-generator': RandomNumberGenerator,
  'qr-code-generator': QrCodeGenerator,
  'qr-code-scanner': QrCodeScanner,
  'regex-tester': RegexTester,
  'image-compressor': ImageCompressor,
  'image-converter': ImageConverter,
  'image-to-base64': ImageToBase64,
  'image-resizer': ImageResizer,
  'exif-viewer': ExifViewer,
  'image-watermark': ImageWatermark,
  'image-color-picker': ImageColorPicker,
  'favicon-generator': FaviconGenerator,
  'image-cropper': ImageCropper,
  'image-filters': ImageFilters,
  'image-to-ascii': ImageToAscii,
  'image-rotator': ImageRotator,
  'metadata-remover': MetadataRemover,
  'color-extractor': ColorExtractor,
  'unit-converter': UnitConverter,
  'scientific-calculator': ScientificCalculator,
  'hash-generator': HashGenerator,
  'jwt-decoder': JwtDecoder,
  'text-diff': TextDiff,
  'mortgage-calculator': MortgageCalculator,
  'age-calculator': AgeCalculator,
  'tip-calculator': TipCalculator,
  'compound-interest-calculator': CompoundInterestCalculator,
  'markdown-editor': MarkdownEditor,
} as const;

const ToolImpl = implementations[tool.slug as keyof typeof implementations];
---

<BaseLayout
  lang={lang}
  title={t(lang, `tools.${tool.slug}.seoTitle`)}
  description={t(lang, `tools.${tool.slug}.description`)}
  schema={toolSchemas(lang, tool)}
>
  <ToolShell tool={tool} lang={lang}>
    <ToolImpl lang={lang} />
  </ToolShell>
</BaseLayout>
