---
import { t, localePath, localeNames, alternateUrl, otherLocales, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const alts = otherLocales(lang).map((l) => ({ l, url: alternateUrl(Astro.url, l) }));
---

<header class="border-b border-line bg-paper/90 backdrop-blur-sm sticky top-0 z-20">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2.5 sm:h-14 sm:flex-nowrap sm:px-6 sm:py-0">
    <a href={localePath(lang, '/')} class="flex shrink-0 items-center gap-2.5 font-display font-bold text-ink">
      <svg width="24" height="24" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
        <rect width="64" height="64" rx="14" fill="#14532d"></rect>
        <path
          d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"
          fill="#fbfaf7"
          transform="translate(8 8) scale(2)"
        ></path>
      </svg>
      <span class="text-[15px] tracking-tight">{t(lang, 'site.name')}</span>
    </a>

    <div class="order-last w-full sm:order-none sm:mx-auto sm:w-auto sm:max-w-xs sm:flex-1 lg:max-w-sm">
      <label for="tool-search" class="sr-only">{t(lang, 'search.label')}</label>
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-soft"
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3" stroke-linecap="round"></path>
        </svg>
        <input
          id="tool-search"
          type="search"
          placeholder={t(lang, 'search.placeholder')}
          autocomplete="off"
          data-home={localePath(lang, '/')}
          class="w-full rounded-lg border border-line bg-white py-1.5 pl-10 pr-4 text-sm text-ink placeholder:text-ink-soft/60 focus:border-pine"
        />
      </div>
    </div>

    <nav class="flex shrink-0 items-center gap-5 text-sm">
      <span class="hidden items-center gap-1.5 text-ink-soft md:flex" title={t(lang, 'common.runsLocally')}>
        <span class="inline-block h-2 w-2 rounded-full bg-pine"></span>
        {t(lang, 'common.runsLocally')}
      </span>
      <details id="lang-menu" class="relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 rounded-md border border-line px-2.5 py-1 text-ink-soft transition-colors hover:border-pine hover:text-pine [&::-webkit-details-marker]:hidden">
          {localeNames[lang]}
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <div class="absolute right-0 z-30 mt-1.5 min-w-28 overflow-hidden rounded-lg border border-line bg-white py-1 shadow-lg">
          {alts.map((a) => (
            <a
              href={a.url}
              hreflang={a.l}
              data-locale={a.l}
              class="block px-3.5 py-1.5 text-ink-soft transition-colors hover:bg-mist hover:text-pine"
            >
              {localeNames[a.l]}
            </a>
          ))}
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  import { write } from '../lib/prefs';

  const menu = document.getElementById('lang-menu') as HTMLDetailsElement | null;
  document.addEventListener('click', (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });

  document.querySelectorAll<HTMLAnchorElement>('#lang-menu a[data-locale]').forEach((a) => {
    a.addEventListener('click', () => write('lang', a.dataset.locale));
  });
</script>

<script>
  const headerSearch = document.getElementById('tool-search') as HTMLInputElement | null;
  headerSearch?.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const q = headerSearch.value.trim();
    if (!q || document.querySelector('.tool-card')) return;
    const home = headerSearch.dataset.home || '/';
    window.location.href = `${home}?q=${encodeURIComponent(q)}`;
  });
</script>
