---
import { t, localePath, type Locale } from '../i18n/utils';
import type { ToolDef } from '../tools/registry';

interface Props {
  tool: ToolDef;
  lang: Locale;
}

const { tool, lang } = Astro.props;
const name = t(lang, `tools.${tool.slug}.name`);
const categoryName = t(lang, `categories.${tool.category}`);
const seoText = t(lang, `tools.${tool.slug}.seo`);
---

<div id="tool-shell" data-slug={tool.slug} class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
  <nav class="mb-6 flex items-center gap-2 text-sm text-ink-soft" aria-label="Breadcrumb">
    <a href={localePath(lang, '/')} class="hover:text-pine">{t(lang, 'common.home')}</a>
    <span aria-hidden="true">/</span>
    <a href={localePath(lang, `/${tool.category}/`)} class="hover:text-pine">{categoryName}</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink">{name}</span>
  </nav>

  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="font-display text-3xl font-bold tracking-tight text-ink">{name}</h1>
      <span class="inline-flex items-center gap-1.5 rounded-full border border-pine/30 bg-mist px-2.5 py-1 font-mono text-xs text-pine">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-pine"></span>
        {t(lang, 'common.runsLocally')}
      </span>
    </div>
    <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">{t(lang, `tools.${tool.slug}.description`)}</p>
  </header>

  <div class="rounded-xl border border-line bg-white/70 p-4 shadow-[0_1px_2px_rgba(27,30,28,0.04)] sm:p-6">
    <slot />
  </div>

  <p class="mt-10 max-w-3xl text-sm leading-relaxed text-ink-soft">{seoText}</p>
</div>

<script>
  import { pushRecent } from '../lib/prefs';
  const shell = document.getElementById('tool-shell');
  if (shell?.dataset.slug) pushRecent(shell.dataset.slug);
</script>
