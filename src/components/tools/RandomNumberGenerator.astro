---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const u = (key: string) => t(lang, `tools.random-number-generator.ui.${key}`);
---

<div id="random-number-generator" data-invalid={u('invalid')} data-copied={t(lang, 'common.copied')}>
  <div class="flex flex-wrap items-end gap-3">
    <div>
      <label for="rng-min" class="rlt-label">{u('min')}</label>
      <input id="rng-min" type="number" value="1" class="rlt-input w-28 font-mono" />
    </div>
    <div>
      <label for="rng-max" class="rlt-label">{u('max')}</label>
      <input id="rng-max" type="number" value="100" class="rlt-input w-28 font-mono" />
    </div>
    <div>
      <label for="rng-count" class="rlt-label">{u('count')}</label>
      <input id="rng-count" type="number" min="1" max="1000" value="5" class="rlt-input w-24 font-mono" />
    </div>
    <button id="rng-generate" class="rlt-btn rlt-btn-primary">{u('generate')}</button>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-4">
    <label class="flex cursor-pointer items-center gap-2 text-sm text-ink">
      <input type="checkbox" id="rng-unique" class="rlt-check" />{u('unique')}
    </label>
    <label class="flex cursor-pointer items-center gap-2 text-sm text-ink">
      <input type="checkbox" id="rng-sort" class="rlt-check" />{u('sort')}
    </label>
    <button data-copy class="rlt-btn rlt-btn-sm">{t(lang, 'common.copy')}</button>
  </div>
  <p id="rng-status" role="status" class="rlt-status mt-2 h-5 text-amber"></p>

  <div id="rng-results" class="mt-3 flex flex-wrap gap-2"></div>
</div>

<script>
  const root = document.getElementById('random-number-generator');
  if (root) {
    const minEl = root.querySelector<HTMLInputElement>('#rng-min')!;
    const maxEl = root.querySelector<HTMLInputElement>('#rng-max')!;
    const countEl = root.querySelector<HTMLInputElement>('#rng-count')!;
    const uniqueEl = root.querySelector<HTMLInputElement>('#rng-unique')!;
    const sortEl = root.querySelector<HTMLInputElement>('#rng-sort')!;
    const status = root.querySelector<HTMLParagraphElement>('#rng-status')!;
    const results = root.querySelector<HTMLDivElement>('#rng-results')!;

    // Rejection sampling on top of crypto for unbiased integers in [min, max].
    const randomInt = (min: number, max: number): number => {
      const range = max - min + 1;
      const limit = Math.floor(4294967296 / range) * range;
      const buf = new Uint32Array(1);
      for (;;) {
        crypto.getRandomValues(buf);
        if (buf[0] < limit) return min + (buf[0] % range);
      }
    };

    const generate = () => {
      status.textContent = '';
      results.innerHTML = '';
      const min = Math.ceil(Number(minEl.value));
      const max = Math.floor(Number(maxEl.value));
      const count = Math.floor(Number(countEl.value));

      if (!Number.isFinite(min) || !Number.isFinite(max) || min > max || count < 1) {
        status.textContent = root.dataset.invalid!;
        return;
      }
      if (uniqueEl.checked && count > max - min + 1) {
        status.textContent = root.dataset.invalid!;
        return;
      }

      let numbers: number[];
      if (uniqueEl.checked) {
        const picked = new Set<number>();
        while (picked.size < count) picked.add(randomInt(min, max));
        numbers = [...picked];
      } else {
        numbers = Array.from({ length: count }, () => randomInt(min, max));
      }
      if (sortEl.checked) numbers.sort((a, b) => a - b);

      for (const n of numbers) {
        const chip = document.createElement('span');
        chip.className =
          'rounded-lg border border-line bg-mist/60 px-3 py-1.5 font-mono text-sm font-medium text-ink';
        chip.textContent = String(n);
        results.appendChild(chip);
      }
    };

    root.querySelector('#rng-generate')!.addEventListener('click', generate);

    root.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
      if (!btn) return;
      const text = [...results.children].map((el) => el.textContent).join(', ');
      if (!text) return;
      await navigator.clipboard.writeText(text);
      const original = btn.textContent!;
      btn.textContent = root.dataset.copied!;
      setTimeout(() => (btn.textContent = original), 1500);
    });

    generate();
  }
</script>
