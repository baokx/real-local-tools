---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const u = (key: string) => t(lang, `tools.unit-converter.ui.${key}`);

// [symbol, en name, zh name, factor to base unit]
const CATS: Record<string, { en: string; zh: string }> = {
  length: { en: 'Length', zh: '长度' },
  weight: { en: 'Weight', zh: '重量' },
  temperature: { en: 'Temperature', zh: '温度' },
  area: { en: 'Area', zh: '面积' },
  volume: { en: 'Volume', zh: '体积' },
  speed: { en: 'Speed', zh: '速度' },
  data: { en: 'Data storage', zh: '数据存储' },
};

const UNITS: Record<string, [string, string, string, number][]> = {
  length: [
    ['m', 'meter', '米', 1], ['km', 'kilometer', '千米', 1000], ['cm', 'centimeter', '厘米', 0.01],
    ['mm', 'millimeter', '毫米', 0.001], ['µm', 'micrometer', '微米', 1e-6],
    ['mi', 'mile', '英里', 1609.344], ['yd', 'yard', '码', 0.9144], ['ft', 'foot', '英尺', 0.3048],
    ['in', 'inch', '英寸', 0.0254], ['nmi', 'nautical mile', '海里', 1852],
  ],
  weight: [
    ['kg', 'kilogram', '千克', 1], ['g', 'gram', '克', 0.001], ['mg', 'milligram', '毫克', 1e-6],
    ['t', 'tonne', '吨', 1000], ['lb', 'pound', '磅', 0.45359237],
    ['oz', 'ounce', '盎司', 0.028349523125], ['st', 'stone', '英石', 6.35029318],
  ],
  temperature: [
    ['°C', 'Celsius', '摄氏度', 1], ['°F', 'Fahrenheit', '华氏度', 1], ['K', 'Kelvin', '开尔文', 1],
  ],
  area: [
    ['m²', 'square meter', '平方米', 1], ['km²', 'square kilometer', '平方千米', 1e6],
    ['ha', 'hectare', '公顷', 1e4], ['ac', 'acre', '英亩', 4046.8564224],
    ['ft²', 'square foot', '平方英尺', 0.09290304], ['in²', 'square inch', '平方英寸', 0.00064516],
    ['mi²', 'square mile', '平方英里', 2589988.110336],
  ],
  volume: [
    ['L', 'liter', '升', 1], ['mL', 'milliliter', '毫升', 0.001], ['m³', 'cubic meter', '立方米', 1000],
    ['gal', 'gallon (US)', '加仑 (美)', 3.785411784], ['qt', 'quart (US)', '夸脱 (美)', 0.946352946],
    ['pt', 'pint (US)', '品脱 (美)', 0.473176473], ['cup', 'cup (US)', '杯 (美)', 0.2365882365],
    ['fl oz', 'fluid ounce (US)', '液量盎司 (美)', 0.0295735295625],
    ['ft³', 'cubic foot', '立方英尺', 28.316846592], ['in³', 'cubic inch', '立方英寸', 0.016387064],
  ],
  speed: [
    ['m/s', 'meters/second', '米/秒', 1], ['km/h', 'kilometers/hour', '千米/时', 1 / 3.6],
    ['mph', 'miles/hour', '英里/时', 0.44704], ['kn', 'knot', '节', 0.514444],
    ['ft/s', 'feet/second', '英尺/秒', 0.3048],
  ],
  data: [
    ['B', 'byte', '字节', 1], ['KB', 'kilobyte', 'KB', 1e3], ['MB', 'megabyte', 'MB', 1e6],
    ['GB', 'gigabyte', 'GB', 1e9], ['TB', 'terabyte', 'TB', 1e12],
    ['KiB', 'kibibyte', 'KiB', 1024], ['MiB', 'mebibyte', 'MiB', 1024 ** 2],
    ['GiB', 'gibibyte', 'GiB', 1024 ** 3], ['TiB', 'tebibyte', 'TiB', 1024 ** 4],
  ],
};

const payload = {
  cats: Object.entries(CATS).map(([id, n]) => ({ id, name: n[lang] })),
  units: Object.fromEntries(
    Object.entries(UNITS).map(([cat, list]) => [
      cat,
      list.map(([sym, en, zh, f]) => ({ sym, name: lang === 'zh' ? zh : en, f })),
    ])
  ),
};
---

<div id="unit-converter" data-units={JSON.stringify(payload)}>
  <div id="uc-tabs" class="flex flex-wrap gap-2">
    {payload.cats.map((c, i) => (
      <button
        type="button"
        data-cat={c.id}
        class:list={[
          'rounded-lg border px-3 py-1.5 text-sm transition-colors',
          i === 0 ? 'border-pine bg-pine text-white' : 'border-line bg-white text-ink hover:border-pine hover:text-pine',
        ]}
      >
        {c.name}
      </button>
    ))}
  </div>

  <div class="mt-5 grid items-end gap-4 sm:grid-cols-[1fr_auto_1fr]">
    <div>
      <label for="uc-value" class="rlt-label">{u('from')}</label>
      <input id="uc-value" type="number" class="rlt-input font-mono" placeholder={u('placeholder')} value="1" />
      <select id="uc-from" class="rlt-input mt-2"></select>
    </div>
    <button
      type="button"
      id="uc-swap"
      title={u('swap')}
      aria-label={u('swap')}
      class="mb-1 hidden h-9 w-9 items-center justify-center justify-self-center rounded-lg border border-line bg-white text-ink-soft transition-colors hover:border-pine hover:text-pine sm:flex"
    >
      ⇄
    </button>
    <div>
      <label class="rlt-label">{u('result')}</label>
      <div id="uc-result" class="flex min-h-[42px] items-center rounded-lg border border-line bg-mist/50 px-3 font-mono text-lg font-semibold text-pine">—</div>
      <select id="uc-to" class="rlt-input mt-2"></select>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('unit-converter');
  if (root) {
    interface UnitOpt { sym: string; name: string; f: number }
    const data = JSON.parse(root.dataset.units!) as {
      cats: { id: string; name: string }[];
      units: Record<string, UnitOpt[]>;
    };

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('#uc-tabs button'));
    const valueEl = root.querySelector<HTMLInputElement>('#uc-value')!;
    const fromSel = root.querySelector<HTMLSelectElement>('#uc-from')!;
    const toSel = root.querySelector<HTMLSelectElement>('#uc-to')!;
    const resultEl = root.querySelector<HTMLElement>('#uc-result')!;
    let cat = 'length';

    const ACTIVE = ['border-pine', 'bg-pine', 'text-white'];
    const IDLE = ['border-line', 'bg-white', 'text-ink'];

    const fmt = (x: number): string => {
      if (!isFinite(x)) return '—';
      const ax = Math.abs(x);
      if (x !== 0 && (ax >= 1e15 || ax < 1e-9)) return x.toExponential(6).replace(/\.?0+e/, 'e');
      return String(parseFloat(x.toPrecision(10)));
    };

    const fillSelects = () => {
      const list = data.units[cat];
      for (const sel of [fromSel, toSel]) {
        sel.innerHTML = '';
        for (const un of list) {
          const o = document.createElement('option');
          o.value = un.sym;
          o.textContent = `${un.sym} — ${un.name}`;
          sel.appendChild(o);
        }
      }
      toSel.selectedIndex = Math.min(1, list.length - 1);
    };

    const convert = () => {
      const v = parseFloat(valueEl.value);
      if (isNaN(v)) { resultEl.textContent = '—'; return; }
      let out: number;
      if (cat === 'temperature') {
        const toC = (x: number, s: string) => (s === '°F' ? (x - 32) * 5 / 9 : s === 'K' ? x - 273.15 : x);
        const fromC = (x: number, s: string) => (s === '°F' ? x * 9 / 5 + 32 : s === 'K' ? x + 273.15 : x);
        out = fromC(toC(v, fromSel.value), toSel.value);
      } else {
        const list = data.units[cat];
        const fF = list.find((un) => un.sym === fromSel.value)!.f;
        const fT = list.find((un) => un.sym === toSel.value)!.f;
        out = (v * fF) / fT;
      }
      resultEl.textContent = fmt(out);
    };

    tabs.forEach((btn) => {
      btn.addEventListener('click', () => {
        cat = btn.dataset.cat!;
        tabs.forEach((b) => {
          const on = b === btn;
          b.classList.remove(...(on ? IDLE : ACTIVE));
          b.classList.add(...(on ? ACTIVE : IDLE));
        });
        fillSelects();
        convert();
      });
    });

    root.querySelector('#uc-swap')!.addEventListener('click', () => {
      const a = fromSel.value;
      fromSel.value = toSel.value;
      toSel.value = a;
      convert();
    });

    valueEl.addEventListener('input', convert);
    fromSel.addEventListener('change', convert);
    toSel.addEventListener('change', convert);

    fillSelects();
    convert();
  }
</script>
