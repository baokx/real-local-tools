---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const u = (key: string) => t(lang, `tools.password-generator.ui.${key}`);
---

<div
  id="password-generator"
  data-copied={t(lang, 'common.copied')}
  data-need-one={u('needOne')}
  data-entropy-tpl={u('entropy')}
  data-strengths={JSON.stringify([u('weak'), u('fair'), u('strong'), u('excellent')])}
>
  <div class="flex flex-col gap-6 lg:flex-row">
    <div class="flex-1">
      <div class="flex items-stretch gap-2">
        <output
          id="pw-output"
          class="flex flex-1 select-all items-center overflow-x-auto whitespace-nowrap rounded-lg border border-line bg-ink px-4 py-3.5 font-mono text-lg text-[#d8e4dc]"
        >{u('placeholder')}</output>
        <button id="pw-copy" class="pw-btn">{t(lang, 'common.copy')}</button>
        <button id="pw-regen" class="pw-btn pw-btn-primary" title={u('regenerate')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-2.64-6.36" stroke-linecap="round"></path>
            <path d="M21 3v6h-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="hidden sm:inline">{u('regenerate')}</span>
        </button>
      </div>

      <div class="mt-3 flex items-center gap-3">
        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-line">
          <div id="pw-meter" class="h-full w-0 rounded-full transition-all duration-300"></div>
        </div>
        <span id="pw-strength" class="w-16 text-right text-sm font-medium"></span>
      </div>
      <p id="pw-entropy" class="mt-1.5 font-mono text-xs text-ink-soft"></p>
    </div>

    <div class="w-full shrink-0 lg:w-72">
      <label for="pw-length" class="mb-1.5 flex items-center justify-between text-sm text-ink">
        <span>{u('length')}</span>
        <span id="pw-length-value" class="font-mono font-medium text-pine">20</span>
      </label>
      <input id="pw-length" type="range" min="8" max="64" value="20" class="w-full accent-[#14532d]" />

      <div class="mt-4 grid gap-2.5 text-sm text-ink">
        <label class="flex cursor-pointer items-center gap-2.5">
          <input type="checkbox" id="pw-lower" checked class="h-4 w-4 accent-[#14532d]" />{u('lowercase')}
        </label>
        <label class="flex cursor-pointer items-center gap-2.5">
          <input type="checkbox" id="pw-upper" checked class="h-4 w-4 accent-[#14532d]" />{u('uppercase')}
        </label>
        <label class="flex cursor-pointer items-center gap-2.5">
          <input type="checkbox" id="pw-number" checked class="h-4 w-4 accent-[#14532d]" />{u('numbers')}
        </label>
        <label class="flex cursor-pointer items-center gap-2.5">
          <input type="checkbox" id="pw-symbol" checked class="h-4 w-4 accent-[#14532d]" />{u('symbols')}
        </label>
        <label class="flex cursor-pointer items-center gap-2.5">
          <input type="checkbox" id="pw-ambiguous" class="h-4 w-4 accent-[#14532d]" />{u('excludeAmbiguous')}
        </label>
      </div>
      <p id="pw-warning" role="alert" class="mt-2 hidden text-sm text-amber"></p>
    </div>
  </div>
</div>

<style>
  .pw-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    padding: 0 0.9rem;
    font-size: 0.8125rem;
    font-weight: 500;
    background: white;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }
  .pw-btn:hover {
    border-color: var(--color-pine);
    color: var(--color-pine);
  }
  .pw-btn-primary {
    background: var(--color-pine);
    border-color: var(--color-pine);
    color: white;
  }
  .pw-btn-primary:hover {
    background: var(--color-pine-dark);
    color: white;
  }
</style>

<script>
  const root = document.getElementById('password-generator');
  if (root) {
    const output = root.querySelector<HTMLOutputElement>('#pw-output')!;
    const lengthEl = root.querySelector<HTMLInputElement>('#pw-length')!;
    const lengthValue = root.querySelector<HTMLSpanElement>('#pw-length-value')!;
    const meter = root.querySelector<HTMLDivElement>('#pw-meter')!;
    const strengthEl = root.querySelector<HTMLSpanElement>('#pw-strength')!;
    const entropyEl = root.querySelector<HTMLParagraphElement>('#pw-entropy')!;
    const warning = root.querySelector<HTMLParagraphElement>('#pw-warning')!;
    const strengths: string[] = JSON.parse(root.dataset.strengths!);

    const sets = {
      lower: { el: root.querySelector<HTMLInputElement>('#pw-lower')!, chars: 'abcdefghijklmnopqrstuvwxyz' },
      upper: { el: root.querySelector<HTMLInputElement>('#pw-upper')!, chars: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' },
      number: { el: root.querySelector<HTMLInputElement>('#pw-number')!, chars: '0123456789' },
      symbol: { el: root.querySelector<HTMLInputElement>('#pw-symbol')!, chars: '!@#$%^&*()-_=+[]{};:,.<>?/~' },
    };
    const ambiguousEl = root.querySelector<HTMLInputElement>('#pw-ambiguous')!;
    const ambiguous = new Set('l1IO0');

    const buildCharset = (): string => {
      let charset = '';
      for (const { el, chars } of Object.values(sets)) {
        if (el.checked) charset += chars;
      }
      if (ambiguousEl.checked) {
        charset = [...charset].filter((ch) => !ambiguous.has(ch)).join('');
      }
      return charset;
    };

    // Rejection sampling avoids modulo bias so every character is equally likely.
    const randomChar = (charset: string): string => {
      const limit = Math.floor(256 / charset.length) * charset.length;
      const buf = new Uint8Array(1);
      for (;;) {
        crypto.getRandomValues(buf);
        if (buf[0] < limit) return charset[buf[0] % charset.length];
      }
    };

    const strengthFor = (bits: number): { label: string; color: string; pct: number } => {
      if (bits < 50) return { label: strengths[0], color: '#b45309', pct: 25 };
      if (bits < 75) return { label: strengths[1], color: '#a3a318', pct: 50 };
      if (bits < 100) return { label: strengths[2], color: '#14532d', pct: 75 };
      return { label: strengths[3], color: '#0e3d21', pct: 100 };
    };

    const generate = () => {
      const charset = buildCharset();
      if (!charset) {
        warning.textContent = root.dataset.needOne!;
        warning.classList.remove('hidden');
        output.textContent = '';
        meter.style.width = '0';
        strengthEl.textContent = '';
        entropyEl.textContent = '';
        return;
      }
      warning.classList.add('hidden');

      const length = Number(lengthEl.value);
      let password = '';
      for (let i = 0; i < length; i++) password += randomChar(charset);
      output.textContent = password;

      const bits = Math.round(length * Math.log2(charset.length));
      const { label, color, pct } = strengthFor(bits);
      meter.style.width = `${pct}%`;
      meter.style.backgroundColor = color;
      strengthEl.textContent = label;
      strengthEl.style.color = color;
      entropyEl.textContent = root.dataset.entropyTpl!.replace('{bits}', String(bits));
    };

    lengthEl.addEventListener('input', () => {
      lengthValue.textContent = lengthEl.value;
      generate();
    });
    for (const { el } of Object.values(sets)) el.addEventListener('change', generate);
    ambiguousEl.addEventListener('change', generate);
    root.querySelector('#pw-regen')!.addEventListener('click', generate);

    root.querySelector('#pw-copy')!.addEventListener('click', async (event) => {
      const password = output.textContent ?? '';
      if (!password) return;
      await navigator.clipboard.writeText(password);
      const btn = event.currentTarget as HTMLButtonElement;
      const original = btn.textContent!;
      btn.textContent = root.dataset.copied!;
      setTimeout(() => (btn.textContent = original), 1500);
    });

    generate();
  }
</script>
