---
import { t, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const u = (key: string) => t(lang, `tools.compound-interest-calculator.ui.${key}`);

const frequencies = [
  { value: 1, key: 'annually' },
  { value: 2, key: 'semiannually' },
  { value: 4, key: 'quarterly' },
  { value: 12, key: 'monthly' },
  { value: 365, key: 'daily' },
];
---

<div id="compound-interest-calculator">
  <div class="grid gap-5 lg:grid-cols-[320px_1fr]">
    <section class="space-y-4 rounded-lg border border-line bg-mist/40 p-4">
      <div>
        <label for="ci-principal" class="rlt-label">{u('principal')}</label>
        <input id="ci-principal" type="number" min="0" step="100" value="10000" class="rlt-input w-full font-mono" />
      </div>
      <div>
        <label for="ci-rate" class="rlt-label">{u('annualRate')}</label>
        <input id="ci-rate" type="number" min="0" step="0.1" value="7" class="rlt-input w-full font-mono" />
      </div>
      <div>
        <label for="ci-years" class="rlt-label">{u('years')}</label>
        <input id="ci-years" type="number" min="1" max="100" step="1" value="20" class="rlt-input w-full font-mono" />
      </div>
      <div>
        <label for="ci-freq" class="rlt-label">{u('frequency')}</label>
        <select id="ci-freq" class="rlt-input w-full">
          {
            frequencies.map((f) => (
              <option value={f.value} selected={f.value === 12}>
                {u(`freq.${f.key}`)}
              </option>
            ))
          }
        </select>
      </div>
      <div>
        <label for="ci-contrib" class="rlt-label">{u('contribution')}</label>
        <input id="ci-contrib" type="number" min="0" step="50" value="0" class="rlt-input w-full font-mono" />
        <p class="mt-1 text-xs text-ink-soft">{u('contributionHint')}</p>
      </div>
    </section>

    <section class="rounded-lg border border-line bg-mist/40 p-4">
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <p class="text-xs text-ink-soft">{u('finalBalance')}</p>
          <p class="mt-1 font-mono text-2xl font-semibold text-pine" id="ci-final">—</p>
        </div>
        <div>
          <p class="text-xs text-ink-soft">{u('totalDeposits')}</p>
          <p class="mt-1 font-mono text-2xl font-semibold text-ink" id="ci-deposits">—</p>
        </div>
        <div>
          <p class="text-xs text-ink-soft">{u('totalInterest')}</p>
          <p class="mt-1 font-mono text-2xl font-semibold text-ink" id="ci-interest">—</p>
        </div>
      </div>

      <div class="mt-6">
        <div class="flex h-36 items-end gap-px" id="ci-chart" aria-hidden="true"></div>
        <div class="mt-1.5 flex justify-between text-xs text-ink-soft">
          <span id="ci-chart-start">—</span>
          <span id="ci-chart-end">—</span>
        </div>
        <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-soft">
          <span><span class="mr-1.5 inline-block h-2 w-2 rounded-sm bg-line align-middle"></span>{u('depositsLabel')}</span>
          <span><span class="mr-1.5 inline-block h-2 w-2 rounded-sm bg-pine align-middle"></span>{u('interestLabel')}</span>
        </div>
      </div>

      <div class="mt-5 max-h-72 overflow-auto rounded-lg border border-line">
        <table class="w-full text-xs">
          <thead class="sticky top-0 bg-mist text-left text-ink-soft">
            <tr>
              <th class="px-3 py-2 font-medium">{u('colYear')}</th>
              <th class="px-3 py-2 text-right font-medium">{u('colDeposits')}</th>
              <th class="px-3 py-2 text-right font-medium">{u('colInterest')}</th>
              <th class="px-3 py-2 text-right font-medium">{u('colBalance')}</th>
            </tr>
          </thead>
          <tbody id="ci-table" class="font-mono text-ink"></tbody>
        </table>
      </div>
      <p id="ci-invalid" class="rlt-status mt-4 hidden">{u('invalid')}</p>
    </section>
  </div>
</div>

<script>
  const root = document.getElementById('compound-interest-calculator');
  if (root) {
    const $ = <T extends HTMLElement = HTMLElement>(id: string) => root.querySelector<T>(`#${id}`)!;
    const principalEl = $<HTMLInputElement>('ci-principal');
    const rateEl = $<HTMLInputElement>('ci-rate');
    const yearsEl = $<HTMLInputElement>('ci-years');
    const freqEl = $<HTMLSelectElement>('ci-freq');
    const contribEl = $<HTMLInputElement>('ci-contrib');
    const chartEl = $('ci-chart');
    const tableEl = $('ci-table');
    const invalidEl = $('ci-invalid');

    const fmt = (n: number): string =>
      n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtShort = (n: number): string => {
      const abs = Math.abs(n);
      if (abs >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
      if (abs >= 1e3) return `${(n / 1e3).toFixed(1)}k`;
      return n.toFixed(0);
    };

    const update = () => {
      const P = Number(principalEl.value);
      const annual = Number(rateEl.value);
      const years = Math.floor(Number(yearsEl.value));
      const n = Number(freqEl.value);
      const C = Number(contribEl.value) || 0;
      const valid = P >= 0 && annual >= 0 && years >= 1 && years <= 100 && C >= 0 && (P > 0 || C > 0);
      invalidEl.classList.toggle('hidden', valid);
      if (!valid) {
        $('ci-final').textContent = '—';
        $('ci-deposits').textContent = '—';
        $('ci-interest').textContent = '—';
        chartEl.innerHTML = '';
        tableEl.innerHTML = '';
        return;
      }

      const r = annual / 100 / n;
      const rows: Array<{ year: number; deposits: number; interest: number; balance: number }> = [];
      let balance = P;
      let deposits = P;
      for (let y = 1; y <= years; y++) {
        for (let p = 0; p < n; p++) {
          balance = balance * (1 + r) + C;
        }
        deposits += C * n;
        rows.push({ year: y, deposits, interest: balance - deposits, balance });
      }

      const finalBalance = balance;
      const totalInterest = finalBalance - deposits;
      $('ci-final').textContent = fmt(finalBalance);
      $('ci-deposits').textContent = fmt(deposits);
      $('ci-interest').textContent = fmt(totalInterest);

      chartEl.innerHTML = rows
        .map((row) => {
          const totalPct = finalBalance > 0 ? (row.balance / finalBalance) * 100 : 0;
          const depPct = finalBalance > 0 ? (row.deposits / finalBalance) * 100 : 0;
          return (
            `<div class="flex min-w-0 flex-1 flex-col justify-end" title="Y${row.year}: ${fmt(row.balance)}">` +
            `<div class="w-full rounded-t-sm bg-pine/90" style="height:${(totalPct - depPct).toFixed(2)}%"></div>` +
            `<div class="w-full bg-line" style="height:${depPct.toFixed(2)}%"></div>` +
            `</div>`
          );
        })
        .join('');
      $('ci-chart-start').textContent = `${fmtShort(P)}`;
      $('ci-chart-end').textContent = `${fmtShort(finalBalance)}`;

      tableEl.innerHTML = rows
        .map(
          (row) =>
            `<tr class="border-t border-line/60"><td class="px-3 py-1.5">${row.year}</td>` +
            `<td class="px-3 py-1.5 text-right">${fmt(row.deposits)}</td>` +
            `<td class="px-3 py-1.5 text-right">${fmt(row.interest)}</td>` +
            `<td class="px-3 py-1.5 text-right">${fmt(row.balance)}</td></tr>`,
        )
        .join('');
    };

    root.addEventListener('input', update);
    root.addEventListener('change', update);
    update();
  }
</script>
