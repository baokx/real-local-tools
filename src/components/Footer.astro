---
import { t, localePath, type Locale } from '../i18n/utils';
import { categories } from '../tools/registry';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const prefix = lang === 'en' ? '' : `/${lang}`;
const links = [
  { href: `${prefix}/about/`, label: t(lang, 'pages.about.title') },
  { href: `${prefix}/privacy/`, label: t(lang, 'pages.privacy.title') },
  { href: `${prefix}/terms/`, label: t(lang, 'pages.terms.title') },
];
const categoryLinks = categories.map((c) => ({
  href: localePath(lang, `/${c}/`),
  label: t(lang, `categories.${c}`),
}));
const headingClass = 'mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-ink-soft/70';
const linkClass = 'text-sm text-ink-soft underline-offset-2 transition-colors hover:text-pine hover:underline';
---

<footer class="mt-16 border-t border-line">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:gap-16">
      <div class="max-w-sm text-sm leading-relaxed text-ink-soft">
        <p>
          <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-pine align-middle"></span>
          {t(lang, 'footer.tagline')}
          {t(lang, 'footer.note')}
        </p>
        <p class="mt-3">
          {t(lang, 'footer.contact')}
          <a href="mailto:contact@real-local-tools.com" class="ml-1 font-mono text-pine underline-offset-2 hover:underline">
            contact@real-local-tools.com
          </a>
        </p>
      </div>

      <nav aria-label="Tool categories">
        <h2 class={headingClass}>{t(lang, 'footer.tools')}</h2>
        <ul class="flex flex-col gap-2">
          {
            categoryLinks.map((l) => (
              <li>
                <a href={l.href} class={linkClass}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Site pages">
        <h2 class={headingClass}>{t(lang, 'footer.pages')}</h2>
        <ul class="flex flex-col gap-2">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class={linkClass}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-line pt-6 font-mono text-xs text-ink-soft">
      © {year} {t(lang, 'site.name')}
    </p>
  </div>
</footer>
