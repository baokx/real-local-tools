---
import { t, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const prefix = lang === 'en' ? '' : `/${lang}`;
const links = [
  { href: `${prefix}/about/`, label: t(lang, 'pages.about.title') },
  { href: `${prefix}/privacy/`, label: t(lang, 'pages.privacy.title') },
  { href: `${prefix}/terms/`, label: t(lang, 'pages.terms.title') },
];
---

<footer class="mt-16 border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm text-ink-soft sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div>
      <p>
        <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-pine align-middle"></span>
        {t(lang, 'footer.tagline')}
        {t(lang, 'footer.note')}
      </p>
      <p class="mt-2">
        {t(lang, 'footer.contact')}
        <a href="mailto:contact@real-local-tools.com" class="ml-1 font-mono text-pine underline-offset-2 hover:underline">
          contact@real-local-tools.com
        </a>
      </p>
      <nav class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1" aria-label="Site pages">
        {
          links.map((l) => (
            <a href={l.href} class="underline-offset-2 transition-colors hover:text-ink hover:underline">
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="font-mono text-xs">© {year} {t(lang, 'site.name')}</p>
  </div>
</footer>
