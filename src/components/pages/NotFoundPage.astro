---
import { t, localePath, type Locale } from '../../i18n/utils';
import { categories, toolsByCategory } from '../../tools/registry';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const cats = categories.filter((c) => toolsByCategory(c).length > 0);
---

<div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-xl text-center">
    <p class="font-mono text-7xl font-medium tracking-tight text-pine sm:text-8xl" aria-hidden="true">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      {t(lang, 'notFound.heading')}
    </h1>
    <p class="mt-3 leading-relaxed text-ink-soft">{t(lang, 'notFound.description')}</p>
    <a href={localePath(lang, '/')} class="rlt-btn rlt-btn-primary mt-8 inline-flex">
      {t(lang, 'notFound.backHome')}
    </a>
  </div>

  <nav class="mt-16 text-center" aria-label={t(lang, 'footer.tools')}>
    <div class="flex flex-wrap justify-center gap-2">
      {
        cats.map((c) => (
          <a
            href={localePath(lang, `/${c}/`)}
            class="rounded-full border border-line bg-white px-3.5 py-1.5 text-sm text-ink transition-colors hover:border-pine hover:text-pine"
          >
            {t(lang, `categories.${c}`)}
          </a>
        ))
      }
    </div>
  </nav>
</div>
