---
import { t, localePath, type Locale } from '../i18n/utils';
import { categories, toolsByCategory } from '../tools/registry';
import ToolCard from './ToolCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const activeCategories = categories.filter((cat) => toolsByCategory(cat).length > 0);
---

<section class="border-b border-line bg-mist/60">
  <div class="mx-auto max-w-5xl px-4 py-7 sm:px-6 sm:py-9">
    <p class="mb-2 font-mono text-xs font-medium uppercase tracking-[0.18em] text-pine">
      {t(lang, 'hero.eyebrow')}
    </p>
    <h1 class="max-w-2xl text-balance font-display text-3xl font-bold leading-[1.12] tracking-tight text-ink sm:text-4xl">
      {t(lang, 'hero.title')}
    </h1>
    <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-ink-soft sm:text-base">
      {t(lang, 'hero.subtitle')}
    </p>
  </div>
</section>

<section id="recent-section" class="hidden border-b border-line">
  <div class="mx-auto max-w-5xl px-4 py-5 sm:px-6">
    <h2 class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-ink-soft">
      {t(lang, 'common.recentlyUsed')}
    </h2>
    <div id="recent-list" class="flex flex-wrap gap-2"></div>
  </div>
</section>

<div class="mx-auto max-w-5xl px-4 sm:px-6">
  <p id="search-empty" class="hidden py-16 text-center text-ink-soft">{t(lang, 'search.empty')}</p>
  {
    activeCategories.map((cat) => (
      <section id={cat} class="category-section scroll-mt-20 py-7" data-category={cat}>
        <h2 class="mb-4 flex items-baseline gap-3 font-display text-xl font-bold tracking-tight text-ink">
          <a href={localePath(lang, `/${cat}/`)} class="transition-colors hover:text-pine">
            {t(lang, `categories.${cat}`)}
          </a>
          <span class="font-mono text-xs font-normal text-ink-soft">{toolsByCategory(cat).length}</span>
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {toolsByCategory(cat).map((tool) => (
            <ToolCard tool={tool} lang={lang} />
          ))}
        </div>
      </section>
    ))
  }
</div>

<script>
  const input = document.getElementById('tool-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.category-section'));
  const emptyMsg = document.getElementById('search-empty');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const hit = !q || (card.dataset.search ?? '').includes(q);
      card.classList.toggle('hidden', !hit);
      if (hit) visible++;
    }
    for (const section of sections) {
      const anyVisible = section.querySelector('.tool-card:not(.hidden)');
      section.classList.toggle('hidden', !anyVisible);
    }
    emptyMsg?.classList.toggle('hidden', visible > 0);
  });

  const preset = new URLSearchParams(window.location.search).get('q');
  if (preset && input) {
    input.value = preset;
    input.dispatchEvent(new Event('input'));
  }
</script>

<script>
  import { read } from '../lib/prefs';

  const recent = read<string[]>('recent', []);
  const recentSection = document.getElementById('recent-section');
  const recentList = document.getElementById('recent-list');
  if (recentSection && recentList && recent.length > 0) {
    const bySlug = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('.tool-card[data-slug]').forEach((c) => {
      bySlug.set(c.dataset.slug!, c);
    });
    const frag = document.createDocumentFragment();
    for (const slug of recent) {
      const card = bySlug.get(slug);
      const href = card?.getAttribute('href');
      if (!card || !href) continue;
      const chip = document.createElement('a');
      chip.href = href;
      chip.textContent = card.querySelector('h3')?.textContent ?? slug;
      chip.className =
        'rounded-full border border-line bg-white px-3.5 py-1.5 text-sm text-ink transition-colors hover:border-pine hover:text-pine';
      frag.appendChild(chip);
    }
    recentList.appendChild(frag);
    if (recentList.childElementCount > 0) {
      recentSection.classList.remove('hidden');
    }
  }
</script>
