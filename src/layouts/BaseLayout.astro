---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, alternateUrl, htmlLang, ogLocale, locales, otherLocales, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  /** JSON-LD schema.org object(s), rendered into a single script tag. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { lang, title, description, schema } = Astro.props;
const pageTitle = title ? `${title} | ${t(lang, 'site.name')}` : t(lang, 'site.title');
const pageDescription = description ?? t(lang, 'site.description');

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`.replace(/^\//, ''), Astro.site);
const jsonLd = schema
  ? Array.isArray(schema)
    ? { '@context': 'https://schema.org', '@graph': schema }
    : { '@context': 'https://schema.org', ...schema }
  : undefined;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <!-- Remembered locale: only the bare root home page redirects, before first paint.
         Crawlers never carry localStorage, so SEO is unaffected. Keep the list in
         sync with the non-default locales in src/i18n/utils.ts. -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('rlt:lang');
          if (!raw) return;
          var lang = JSON.parse(raw);
          if (lang === 'en' || window.location.pathname !== '/') return;
          if (['zh', 'es', 'ja'].indexOf(lang) === -1) return;
          window.location.replace('/' + lang + '/');
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alternateUrl(Astro.url, l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternateUrl(Astro.url, 'en'), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(lang, 'site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {otherLocales(lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- Cloudflare Web Analytics: cookieless, no personal data collected -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "4b7e81251e054b71a1093eaf820d79c2"}'></script>
  </body>
</html>
